{
  "$schema": "./schema.json",
  "id": "graphite",
  "label": "Shadcn Graphite",
  "description": "Neutral graphite greys, the classic shadcn desktop.",
  "source": "tweakcn/shadcn Graphite preset (oklch), converted to sRGB hex",
  "radius": 6,
  "strokeJoin": "round",
  "wallpaper": "dots",
  "fonts": {
    "interface": "Geist 11",
    "document": "Geist 11",
    "monospace": "Geist Mono 11"
  },
  "schemes": {
    "dark": {
      "colors": {
        "bg": "#1a1a1a",
        "fg": "#d9d9d9",
        "card": "#202020",
        "popover": "#202020",
        "headerbar": "#1f1f1f",
        "sidebar": "#1f1f1f",
        "secondarySidebar": "#1d1d1d",
        "primary": "#a0a0a0",
        "primaryFg": "#1a1a1a",
        "accentText": "#c8c8c8",
        "secondary": "#303030",
        "hover": "#2c2c2c",
        "activeSel": "#454545",
        "accent": "#404040",
        "muted": "#2a2a2a",
        "mutedFg": "#8c8c8c",
        "border": "#353535",
        "input": "#303030",
        "ring": "#a0a0a0",
        "destructive": "#e06666",
        "destructiveTint": "#e88a8a",
        "success": "#7e9ca0",
        "warning": "#d9b48a"
      },
      "terminal": {
        "bg": "#1a1a1a",
        "fg": "#d9d9d9",
        "cursor": "#a0a0a0",
        "black": "#1a1a1a",
        "white": "#d9d9d9",
        "brBlack": "#5a5a5a",
        "brWhite": "#f0f0f0"
      }
    },
    "light": {
      "colors": {
        "bg": "#f0f0f0",
        "fg": "#333333",
        "card": "#f7f7f7",
        "popover": "#f7f7f7",
