        "sidebar": "#e9e9e9",
        "secondarySidebar": "#ececec",
        "primary": "#606060",
        "primaryFg": "#ffffff",
        "accentText": "#4d4d4d",
        "secondary": "#e3e3e3",
        "hover": "#e8e8e8",
        "activeSel": "#d6d6d6",
        "accent": "#d4d4d4",
        "muted": "#e6e6e6",
        "mutedFg": "#666666",
        "border": "#d0d0d0",
        "input": "#e3e3e3",
        "ring": "#606060",
        "destructive": "#cc3333",
        "destructiveTint": "#b82e2e",
        "success": "#476666",
        "warning": "#a67c25"
      },
      "terminal": {
        "bg": "#f0f0f0",
        "fg": "#333333",
        "cursor": "#606060",
        "black": "#333333",
        "brBlack": "#666666"
      },
      "darkPanel": {
        "panel": "#161616",
        "panelFg": "#ededed",
        "panelBorder": "#262626",
        "panelHover": "#262626",
        "panelActive": "#303030"
      }
    }
