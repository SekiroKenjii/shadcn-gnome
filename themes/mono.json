{
  "$schema": "./schema.json",
  "id": "mono",
  "label": "Shadcn Mono",
  "description": "Pure neutral monochrome with square corners, the sharpest look.",
  "source": "tweakcn/shadcn Mono preset (oklch), converted to sRGB hex",
  "radius": 0,
  "strokeJoin": "miter",
  "wallpaper": "grid",
  "fonts": {
    "interface": "Geist 11",
    "document": "Geist 11",
    "monospace": "Geist Mono 11"
  },
  "schemes": {
    "dark": {
      "colors": {
        "bg": "#0a0a0a",
        "fg": "#fafafa",
        "card": "#191919",
        "popover": "#262626",
        "headerbar": "#171717",
        "sidebar": "#171717",
        "secondarySidebar": "#141414",
        "primary": "#737373",
        "primaryFg": "#fafafa",
        "accentText": "#c8c8c8",
        "secondary": "#262626",
        "hover": "#303030",
        "activeSel": "#4a4a4a",
        "accent": "#404040",
        "muted": "#262626",
        "mutedFg": "#a1a1a1",
        "border": "#383838",
        "input": "#525252",
        "ring": "#737373",
        "destructive": "#ff6467",
        "destructiveTint": "#ff8a8c",
        "success": "#7e9ca0",
        "warning": "#d9b48a"
      },
      "terminal": {
        "bg": "#0a0a0a",
        "fg": "#fafafa",
        "cursor": "#737373",
        "black": "#0a0a0a",
        "white": "#fafafa",
        "brBlack": "#525252",
        "brWhite": "#ffffff"
      }
    },
    "light": {
      "colors": {
        "bg": "#ffffff",
        "fg": "#0a0a0a",
        "card": "#ffffff",
        "popover": "#ffffff",
        "headerbar": "#fafafa",
        "sidebar": "#fafafa",
        "secondarySidebar": "#f7f7f7",
        "primary": "#737373",
        "primaryFg": "#fafafa",
        "accentText": "#404040",
        "secondary": "#f5f5f5",
        "hover": "#f2f2f2",
        "activeSel": "#e5e5e5",
        "accent": "#ebebeb",
        "muted": "#f5f5f5",
        "mutedFg": "#737373",
        "border": "#e5e5e5",
        "input": "#e5e5e5",
        "ring": "#a3a3a3",
        "destructive": "#e7000b",
        "destructiveTint": "#c70009",
        "success": "#476666",
        "warning": "#a67c25"
      },
      "terminal": {
        "bg": "#ffffff",
        "fg": "#0a0a0a",
        "cursor": "#737373",
        "black": "#0a0a0a",
        "brBlack": "#525252"
      },
      "darkPanel": {
        "panel": "#0a0a0a",
        "panelFg": "#ededed",
        "panelBorder": "#262626",
        "panelHover": "#262626",
        "panelActive": "#303030"
      }
    }
  }
}
