{
  "$schema": "./schema.json",
  "id": "vercel",
  "label": "Shadcn Vercel",
  "description": "Pure black canvas with a white primary, the Geist look.",
  "source": "tweakcn/shadcn Vercel preset (oklch), converted to sRGB hex",
  "radius": 8,
  "strokeJoin": "round",
  "wallpaper": "spotlight",
  "fonts": {
    "interface": "Geist 11",
    "document": "Geist 11",
    "monospace": "Geist Mono 11"
  },
  "schemes": {
    "dark": {
      "colors": {
        "bg": "#000000",
        "fg": "#ffffff",
        "card": "#090909",
        "popover": "#121212",
        "headerbar": "#121212",
        "sidebar": "#121212",
        "secondarySidebar": "#0e0e0e",
        "primary": "#ffffff",
        "primaryFg": "#000000",
        "accentText": "#cccccc",
        "secondary": "#222222",
        "hover": "#2a2a2a",
        "activeSel": "#3d3d3d",
        "accent": "#333333",
        "muted": "#1d1d1d",
        "mutedFg": "#a4a4a4",
        "border": "#242424",
        "input": "#333333",
        "ring": "#a4a4a4",
        "destructive": "#ff5b5b",
        "destructiveTint": "#ff8080",
        "success": "#7e9ca0",
        "warning": "#d9b48a"
      },
      "terminal": {
        "bg": "#000000",
        "fg": "#ffffff",
        "cursor": "#a4a4a4",
        "black": "#000000",
        "white": "#ffffff",
        "brBlack": "#4d4d4d",
        "brWhite": "#ffffff"
      }
    },
    "light": {
      "colors": {
        "bg": "#fcfcfc",
        "fg": "#000000",
        "card": "#ffffff",
        "popover": "#ffffff",
        "headerbar": "#f5f5f5",
        "sidebar": "#f5f5f5",
        "secondarySidebar": "#f8f8f8",
        "primary": "#000000",
        "primaryFg": "#ffffff",
        "accentText": "#333333",
        "secondary": "#ebebeb",
        "hover": "#f0f0f0",
        "activeSel": "#e4e4e4",
        "accent": "#ebebeb",
        "muted": "#f5f5f5",
        "mutedFg": "#525252",
        "border": "#e4e4e4",
        "input": "#ebebeb",
        "ring": "#000000",
        "destructive": "#d4343a",
        "destructiveTint": "#c22f35",
        "success": "#476666",
        "warning": "#a67c25"
      },
      "terminal": {
        "bg": "#ffffff",
        "fg": "#000000",
        "cursor": "#606060",
        "black": "#000000",
        "brBlack": "#4d4d4d"
      },
      "darkPanel": {
        "panel": "#000000",
        "panelFg": "#ededed",
        "panelBorder": "#1c1c1c",
        "panelHover": "#262626",
        "panelActive": "#303030"
      }
    }
  }
}
