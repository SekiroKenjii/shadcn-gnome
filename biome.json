{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!build", "!node_modules", "!assets/icons/mapping.json", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["shell-extension/**", "dev/headless/**/*.js"],
      "formatter": { "indentWidth": 4 },
      "javascript": { "formatter": { "bracketSpacing": false } }
    }
  ]
}
